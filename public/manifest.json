{
    "name": "Vesta",
    "short_name": "Vesta",
    "description": "Tu registro de finanzas personales, inteligente y sin complicaciones.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#0a0a0a",
    "theme_color": "#3b82f6",
    "icons": [
        {
            "src": "/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "/share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "file",
                    "accept": [
                        "image/*",
                        "application/pdf",
                        ".jpg",
                        ".jpeg",
                        ".png",
                        ".webp",
                        ".pdf"
                    ]
                }
            ]
        }
    }
}